# Copy this file to ".env" ONLY if you test the logins function on your own
# computer with `npx netlify dev`. The real .env is ignored by Git.
# On the live site these are set in Netlify → Site configuration → Environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-secret-key-here-never-commit
