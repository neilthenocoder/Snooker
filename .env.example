# Copy this file to ".env" ONLY if you test the logins function on your own
# computer with `npx netlify dev`. The real .env is ignored by Git.
# On the live site these are set in Netlify → Site configuration → Environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-secret-key-here-never-commit

# Result emails (netlify/functions/result-email.mjs) — sent with https://resend.com
RESEND_API_KEY=re_paste-your-resend-api-key-never-commit
# Leave RESULTS_EMAIL_FROM out while testing (Resend's test sender is used, which only reaches your own Resend email).
# RESULTS_EMAIL_FROM=St Blazey Snooker League <results@yourdomain.co.uk>
